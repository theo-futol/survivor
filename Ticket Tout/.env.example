# Local development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Generate a strong secret before production, for example with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-secret-of-at-least-32-characters

# Optional. By default the app stores auth data in ./data/app-auth.sqlite
# BETTER_AUTH_DB_PATH=/absolute/persistent/path/app-auth.sqlite
