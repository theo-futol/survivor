{
  "name": "app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --experimental-https --experimental-https-key ./certificates/localhost+2-key.pem --experimental-https-cert ./certificates/localhost+2.pem --webpack",
    "build": "npm run db:generate && next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:generate": "prisma contract emit",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify",
    "db:seed:generate": "tsx dev/generate-seed.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "ci:test:backend:unit": "npm run test -- --testPathPatterns=tests/api",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "brand:check": "node scripts/check-brand.mjs",
    "auth:check": "node scripts/check-auth-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@base-ui/react": "^1.7.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "@types/leaflet": "^1.9.22",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.2.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jest": "^30.5.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^8.0.0-rc.12",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "better-auth": {
      "prisma": "$prisma"
    }
  }
}
