// use prisma-next

types {
  WgsGeometry = postgis.Geometry(4326)
}

enum Role {
  EMPLOYEE
  COMPANY
  PARTNER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACCEPTED
  REFUSED
  INACTIF
}

model CompanyCategory {
  id        Int       @id @default(autoincrement())
  category  String    @unique
  companies Company[]
}

model CompanyValidationReason {
  id        Int       @id @default(autoincrement())
  reason    String
  companies Company[]
}

model Document {
  id         String   @id @default(uuid())
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())
  company    Company?

  @@index([createdAt])
  @@index([storageKey])
}

model AdminUser {
  userId    String              @id
  user      Users               @relation(fields: [userId], references: [id])
  refusals  UserRefusalReason[] @relation("AgentRefusals")
  companies Company[]           @relation("CompanyAgent")
}

model Users {
  id                     String              @id @default(uuid())
  email                  String              @unique
  surname                String
  name                   String
  role                   Role
  balance                Int
  password               String
  createdAt              DateTime            @default(now())
  updatedAt              temporal.updatedAt()
  expiredAt              DateTime?
  companyId              String?
  company                Company?            @relation("CompanyEmployees", fields: [companyId], references: [id])
  transactions           Transaction[]

  accountStatus          AccountStatus       @default(PENDING)
  refusalsAsUser         UserRefusalReason[] @relation("UserRefusals")
  adminUser              AdminUser?

  @@index([role])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([companyId])
  @@index([accountStatus])
}

model Company {
  id           String                  @id @default(uuid())
  name         String
  email        String                  @unique
  siret        String                  @unique
  kbisId       String                  @unique
  kbis         Document                @relation(fields: [kbisId], references: [id])
  description  String
  address      String
  postalCode   String
  agentId      String
  agent        AdminUser               @relation("CompanyAgent", fields: [agentId], references: [userId])
  reasonId     Int
  reason       CompanyValidationReason @relation(fields: [reasonId], references: [id])
  verified     Boolean
  isFeatured   Boolean
  categoryId   Int
  category     CompanyCategory         @relation(fields: [categoryId], references: [id])
  location     WgsGeometry
  isPartner    Boolean
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    temporal.updatedAt()
  transactions Transaction[]
  employees    Users[]                 @relation("CompanyEmployees")

  @@index([verified])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([agentId])
  @@index([reasonId])
  @@index([active])
}

enum TransactionType {
  PAYMENT
  REFUND
  TOPUP
}

enum TransactionStatus {
  REFUSER
  VALIDER
}

model Transaction {
  id                     String            @id @default(uuid())
  type                   TransactionType
  userId                 String
  user                   Users             @relation(fields: [userId], references: [id])
  companyId              String?
  company                Company?          @relation(fields: [companyId], references: [id])
  amount                 Int
  newBalance             Int
  originalTransactionId  String?           @unique
  originalTransaction    Transaction?      @relation("RefundOf", fields: [originalTransactionId], references: [id])
  refund                 Transaction?      @relation("RefundOf")
  status                 TransactionStatus
  createdAt              DateTime          @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([type])
  @@index([createdAt])
  @@index([status])
}

model QrCode {
  id        Int @id  @default(autoincrement())
  content   String
  expiredAt DateTime
  userId    String
  users     Users    @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([content])
  @@index([userId])
  @@index([companyId])
}

model MinisterFavorite {
  id Int              @id @default(autoincrement())
  companyId  String   @unique
  company    Company  @relation(fields: [companyId], references: [id])
  likeAmount Int
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()
}

model BannedUser {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  user      Users    @relation(fields: [userId], references: [id])
  reason    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserRefusalReason {
  id        Int       @id @default(autoincrement())
  reason    String
  agentId   String
  agent     AdminUser @relation("AgentRefusals", fields: [agentId], references: [userId])
  userId    String
  user      Users     @relation("UserRefusals", fields: [userId], references: [id])
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}
