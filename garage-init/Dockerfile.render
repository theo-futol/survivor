# Long-running Garage service for Render (used by render.yaml), separate
# from ./Dockerfile which builds the one-shot garage-config init image
# consumed by docker-compose/Cloudflare/CI and must not change.
#
# The garage binary is copied onto a debian:bookworm-slim base (rather
# than run from the upstream image directly) so a shell is guaranteed to
# be present for config templating at container start, regardless of
# what dxflrs/garage's own base image happens to be.
FROM dxflrs/garage:v2.3.0 AS garage-bin

FROM debian:bookworm-slim

COPY --from=garage-bin /garage /usr/local/bin/garage

WORKDIR /garage-init
COPY garage.toml.template render-entrypoint.sh ./
RUN chmod +x render-entrypoint.sh

ENTRYPOINT ["/garage-init/render-entrypoint.sh"]
